{
  "name": "scintilla",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "description": "An iOS-first migraine app whose hero feature shows other people what your aura looks like.",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "renderer:build": "npm --prefix renderer run build && node scripts/sync-renderer.mjs",
    "renderer:dev": "npm --prefix renderer run dev",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check": "npm run check:dashes && npm run check:schema && npm run typecheck && npm test && npm run test:server",
    "schema:export": "tsx scripts/export-schema.ts",
    "check:schema": "tsx scripts/export-schema.ts --check",
    "test:server": "cd server && ./.venv/bin/python -m pytest",
    "engine:simulate": "tsx packages/engine/simulation/run.ts",
    "engine:calibrate": "tsx packages/engine/simulation/calibrate.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-brightness": "~57.0.2",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.2.0",
    "jest-expo": "~57.0.5",
    "ts-jest": "^29.4.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "schema",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/packages/**/__tests__/**/*.test.ts",
          "<rootDir>/src/__tests__/**/*.test.ts"
        ],
        "moduleNameMapper": {
          "^@aura/schema$": "<rootDir>/packages/aura-schema/src/index",
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      },
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/src/**/__tests__/**/*.test.tsx"
        ]
      }
    ]
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
